<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             
             xmlns:local="using:AvaloniaApplication7.Content"
             
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaApplication7.Content.Picker"
             
             x:DataType="local:Picker">
             
    <Border Background="{StaticResource BgColor}">
    <StackPanel Margin="20">
        <TextBlock Text="Выберите исполнителя:" />
        
        <ComboBox ItemsSource="{Binding Groups}"
                  SelectedItem="{Binding SelectedSinger}"
                  DisplayMemberBinding="{Binding Name}"
                  PlaceholderText="Исполнители..." />
        
        <TextBlock Text = "{Binding SelectedSinger.Name, StringFormat='Песни исполнителя: {0}'}" Margin="0,20,0,0" />
        
        <ListBox ItemsSource="{Binding Songs}" MaxHeight="250">
            <ListBox.ItemTemplate>
                <DataTemplate> <StackPanel Margin="5">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text="{Binding Duration}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
    </Border>
</UserControl>
