<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:AvaloniaApplication7.Content"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
             x:Class="AvaloniaApplication7.Content.CustomProgressBar"
             x:DataType="local:CustomProgressBar">
    
    
    
    <Border Background="{StaticResource BgColor}">
        <Grid RowDefinitions="*, *, *" Margin="5">
            <TextBlock FontSize="40"
                       HorizontalAlignment="Center">Intergral</TextBlock>
            <ProgressBar Grid.Row="1"  Height="20"   Value="{Binding CurrentValue}" Background="Brown" Foreground="BlueViolet" ShowProgressText="True"/>
            
            
            <WrapPanel Grid.Row="2"  Margin="5" HorizontalAlignment="Center">
                <Button Classes="" Content="Start" Foreground="{StaticResource PrColor}" HorizontalAlignment="Left" Click="OnButtonStartClicked"/>
                <Button Classes="" Content="Stop"  Foreground="{StaticResource PrColor}" HorizontalAlignment="Right" Click="OnButtonStopClicked"/>
            </WrapPanel>
        </Grid>
    </Border>

</UserControl>
